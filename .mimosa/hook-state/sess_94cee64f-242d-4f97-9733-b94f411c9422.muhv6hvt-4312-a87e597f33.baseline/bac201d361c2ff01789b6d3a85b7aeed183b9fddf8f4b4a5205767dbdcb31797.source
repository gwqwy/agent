"""卅码 Agent stdio 服务：编辑器扩展与本 agent 之间的通信进程。

协议：stdin/stdout 上每行一个 JSON 对象（UTF-8）。
    请求: {"id": 1, "action": "chat", "payload": {"message": "你好"}}
    响应: {"id": 1, "ok": true, "data": {...}} 或 {"id": 1, "ok": false, "error": "..."}
    请求 action: chat / models / switch / status / get_models / save_models / reload

启动失败（配置缺失、nanoagent 未安装等）**不会退出进程**，而是进入降级模式：
    - chat/models/switch 等动作返回带具体原因的错误
    - get_models 返回空模板，设置面板可以从此开始可视化配置
    - save_models 写好配置后自动尝试拉起真正的 agent（reload 亦可）

命令行参数：
    python agent_server.py --config <agent.json 路径> --workspace <工作区> [--sahou <解释器路径>]
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path
from typing import Any, Dict, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))

from bridge import AgentBridge


class DegradedBridge:
    """初始化失败时的兜底桥：进程保持存活，引导用户从设置面板完成配置。"""

    def __init__(self, config_path: Path, workspace: Path, sahou_exe: str, init_error: str):
        self.config_path = Path(config_path)
        self.workspace = Path(workspace)
        self.sahou_exe = sahou_exe
        self.error = init_error
        self._real: Any = None

    def _try_build(self) -> Optional[AgentBridge]:
        try:
            return AgentBridge(self.config_path, self.workspace, sahou_exe=self.sahou_exe)
        except Exception as exc:  # noqa: BLE001
            self.error = f"{type(exc).__name__}: {exc}"
            return None

    def handle(self, action: str, payload: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        payload = payload or {}
        # 真正的 agent 一旦拉起成功，所有请求直接委派给它
        if self._real is not None and action != "reload":
            return self._real.handle(action, payload)
        if action == "reload":
            self._real = self._try_build()
            if self._real is not None:
                info = self._real.pool.info()
                return {"ok": True, "data": {"current": info["current"], "models": info["models"]}}
            return {"ok": False, "error": "agent 仍无法启动：" + self.error}
        if action == "get_models":
            # 返回空模板：设置面板据此从零开始配置
            return {"ok": True, "data": {
                "default": "", "models": [], "config_path": str(self.config_path),
                "init_error": self.error,
            }}
        if action == "save_models":
            # 先把配置写盘，再尝试拉起真正的 agent
            models = payload.get("models") or []
            default = payload.get("default") or ""
            if not models:
                return {"ok": False, "error": "至少需要配置一个模型"}
            try:
                self.config_path.parent.mkdir(parents=True, exist_ok=True)
                self.config_path.write_text(
                    json.dumps({"default": default, "models": models}, ensure_ascii=False, indent=2),
                    encoding="utf-8",
                )
            except OSError as exc:
                return {"ok": False, "error": f"配置文件写入失败: {exc}"}
            self._real = self._try_build()
            if self._real is not None:
                info = self._real.pool.info()
                return {"ok": True, "data": {"current": info["current"], "models": info["models"]}}
            return {"ok": False, "error": "配置已保存，但 agent 启动失败：" + self.error}
        if action == "status":
            return {"ok": True, "data": {"model": "", "workspace": str(self.workspace),
                                         "config": str(self.config_path), "usage": {}}}
        if action == "models":
            return {"ok": True, "data": {"models": [], "current": ""}}
        # chat / switch 等：给出可操作的错误说明
        hint = "未配置。请点击「模型设置…」完成模型与 API Key 配置后保存"
        if "nanoagent" in self.error.lower() or "No module named" in self.error:
            hint = ("当前 Python 缺少 nanoagent 框架（需 Python 3.10+）。两种解决："
                    "(1) 把设置 sahou.agent.pythonPath 指向已装 nanoagent 的 Python；"
                    "(2) 对该 Python 执行本地安装：pip install <nanoagent 项目目录>（框架未发布 PyPI）")
        return {"ok": False, "error": f"Agent {hint}。原因: {self.error}"}


def serve(bridge: Any) -> None:
    # Windows 下子进程 stdout/stderr 默认跟随控制台代码页（GBK），中文会乱码；
    # 扩展侧按 UTF-8 读取，这里统一强制 UTF-8
    for stream in (sys.stdin, sys.stdout, sys.stderr):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace")
        except Exception:  # noqa: BLE001 —— 极老解释器无 reconfigure 时维持原样
            pass
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            request = json.loads(line)
            request_id = request.get("id")
            bridge_out = bridge.handle(request.get("action", ""), request.get("payload") or {})
        except json.JSONDecodeError as exc:
            bridge_out = {"ok": False, "error": f"请求不是合法 JSON: {exc}"}
            request_id = None
        except Exception as exc:  # noqa: BLE001 —— 单个请求出错不终止服务
            bridge_out = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
            request_id = None
        response = {"id": request_id}
        response.update(bridge_out)
        sys.stdout.write(json.dumps(response, ensure_ascii=False) + "\n")
        sys.stdout.flush()


def main() -> None:
    parser = argparse.ArgumentParser(description="卅码 Agent stdio 服务")
    parser.add_argument("--config", required=True, help="agent.json 配置文件路径（不使用 .env）")
    parser.add_argument("--workspace", default="", help="工作区根目录")
    parser.add_argument("--sahou", default="sahou", help="sahou 解释器路径")
    args = parser.parse_args()

    workspace = Path(args.workspace) if args.workspace else Path.cwd()
    try:
        bridge: Any = AgentBridge(args.config, workspace, sahou_exe=args.sahou)
        sys.stderr.write("[sahou-agent] bridge ready\n")
    except Exception as exc:  # noqa: BLE001 —— 初始化失败进入降级模式，进程必须存活
        sys.stderr.write(f"[sahou-agent] bridge init failed: {type(exc).__name__}: {exc}\n")
        sys.stderr.flush()
        bridge = DegradedBridge(Path(args.config), workspace, args.sahou,
                                f"{type(exc).__name__}: {exc}")
    serve(bridge)


if __name__ == "__main__":
    main()
