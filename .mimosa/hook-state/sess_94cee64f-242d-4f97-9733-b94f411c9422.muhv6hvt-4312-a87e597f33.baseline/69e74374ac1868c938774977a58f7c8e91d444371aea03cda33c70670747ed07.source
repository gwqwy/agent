// 卅码 Agent 集成：侧边栏对话面板 + 多模型自主切换。
// 通过 stdio 行 JSON 协议与 Python 桥（agent/agent_server.py，基于 nanoagent 框架）通信。
// 模型配置放在工作区 .sahou/agent.json（不使用 .env）；模型可由人手动切换，
// 也可以由 agent 在对话中自主调用 switch_model 工具切换。
const vscode = require("vscode");
const { spawn } = require("child_process");
const path = require("path");
const fs = require("fs");

let bridge = null; // AgentBridgeProcess 单例
let statusBarItem = null;
let currentModel = "";
let chatPanelView = null; // 对话面板视图（保存配置后刷新模型下拉用）

function pythonPath() {
  return vscode.workspace.getConfiguration("sahou").get("agent.pythonPath", "python").trim() || "python";
}

function bridgePath() {
  const configured = vscode.workspace.getConfiguration("sahou").get("agent.bridgePath", "").trim();
  if (configured) return configured;
  // 查找顺序：产品内置（extensions/sahou/agent/）→ 仓库开发态（../agent/）→ 产品 app 层
  const candidates = [
    path.join(__dirname, "agent", "agent_server.py"),
    path.resolve(__dirname, "..", "agent", "agent_server.py"),
    path.resolve(__dirname, "..", "..", "agent", "agent_server.py"),
  ];
  for (const candidate of candidates) {
    if (fs.existsSync(candidate)) return candidate;
  }
  return candidates[0];
}

function configPath() {
  const configured = vscode.workspace.getConfiguration("sahou").get("agent.configPath", "").trim();
  if (configured) return configured;
  const folder = vscode.workspace.workspaceFolders && vscode.workspace.workspaceFolders[0];
  const name = vscode.workspace.getConfiguration("sahou").get("agent.configName", "agent.json");
  return folder ? path.join(folder.uri.fsPath, ".sahou", name) : path.join(".sahou", name);
}

function workspacePath() {
  const folder = vscode.workspace.workspaceFolders && vscode.workspace.workspaceFolders[0];
  return folder ? folder.uri.fsPath : process.cwd();
}

function sahouExe() {
  const configured = vscode.workspace.getConfiguration("sahou").get("path", "").trim();
  if (configured) return configured;
  const builtin = path.join(__dirname, "bin", "sahou.exe");
  return fs.existsSync(builtin) ? builtin : "sahou";
}

// ---------- 桥进程：spawn Python，按行收发 JSON ----------

class AgentBridgeProcess {
  constructor() {
    this.proc = null;
    this.buffer = "";
    this.pending = new Map(); // id -> {resolve, reject}
    this.nextId = 1;
    this.stderrTail = []; // 最近 8 行 stderr，进程异常退出时带给用户
  }

  ensureStarted() {
    if (this.proc) return;
    const args = [
      bridgePath(),
      "--config", configPath(),
      "--workspace", workspacePath(),
      "--sahou", sahouExe(),
    ];
    try {
      this.proc = spawn(pythonPath(), args, { shell: false, windowsHide: true });
    } catch (err) {
      throw new Error(`无法启动 Python 桥（${pythonPath()}）: ${err.message}`);
    }
    this.proc.stdout.setEncoding("utf8");
    this.proc.stdout.on("data", (chunk) => {
      this.buffer += chunk;
      let index;
      while ((index = this.buffer.indexOf("\n")) >= 0) {
        const line = this.buffer.slice(0, index).trim();
        this.buffer = this.buffer.slice(index + 1);
        if (!line) continue;
        let message;
        try {
          message = JSON.parse(line);
        } catch (err) {
          continue;
        }
        const waiter = this.pending.get(message.id);
        if (waiter) {
          this.pending.delete(message.id);
          if (message.ok) waiter.resolve(message.data);
          else waiter.reject(new Error(message.error || "agent 请求失败"));
        }
      }
    });
    this.proc.stderr.setEncoding("utf8");
    this.proc.stderr.on("data", (chunk) => {
      // 桥的报错记入环形缓冲（进程退出时附给用户），并打到调试控制台
      for (const line of String(chunk).split("\n")) {
        const t = line.trim();
        if (t) {
          this.stderrTail.push(t);
          if (this.stderrTail.length > 8) this.stderrTail.shift();
        }
      }
      console.error("[sahou-agent]", chunk);
    });
    this.proc.on("exit", (code) => {
      this.proc = null;
      const tail = this.stderrTail.join("\n");
      for (const [, waiter] of this.pending) {
        waiter.reject(new Error(`Agent 桥进程已退出（code ${code}）${tail ? "\n" + tail : ""}`));
      }
      this.pending.clear();
      if (statusBarItem) statusBarItem.text = "$(hubot) 卅码 Agent（未连接）";
    });
  }

  request(action, payload) {
    this.ensureStarted();
    const id = this.nextId++;
    const payloadJson = JSON.stringify({ id, action, payload: payload || {} });
    return new Promise((resolve, reject) => {
      this.pending.set(id, { resolve, reject });
      this.proc.stdin.write(payloadJson + "\n");
      setTimeout(() => {
        if (this.pending.has(id)) {
          this.pending.delete(id);
          reject(new Error("Agent 请求超时（120s）"));
        }
      }, 120000);
    });
  }

  stop() {
    if (this.proc) {
      this.proc.kill();
      this.proc = null;
    }
  }
}

async function bridgeRequest(action, payload) {
  if (!bridge) bridge = new AgentBridgeProcess();
  return bridge.request(action, payload);
}

async function refreshModelStatus() {
  try {
    const data = await bridgeRequest("status");
    currentModel = data.model || "";
    if (statusBarItem) statusBarItem.text = `$(hubot) 卅码 Agent: ${currentModel}`;
  } catch (err) {
    if (statusBarItem) statusBarItem.text = "$(hubot) 卅码 Agent（未连接）";
  }
}

function chatPanelPost(message) {
  if (chatPanelView) chatPanelView.webview.postMessage(message);
}

// ---------- 手动切换模型（QuickPick） ----------

async function switchModelCommand() {
  let models;
  try {
    models = await bridgeRequest("models");
  } catch (err) {
    vscode.window.showErrorMessage(`卅码 Agent：${err.message}`);
    return;
  }
  const picked = await vscode.window.showQuickPick(
    models.models.map((name) => ({
      label: name === models.current ? `$(check) ${name}` : name,
      name,
    })),
    { placeHolder: "切换 Agent 使用的模型（当前: " + models.current + "）" }
  );
  if (!picked) return;
  try {
    const data = await bridgeRequest("switch", { name: picked.name });
    vscode.window.showInformationMessage(`卅码 Agent：${data.result}`);
    refreshModelStatus();
  } catch (err) {
    vscode.window.showErrorMessage(`卅码 Agent：${err.message}`);
  }
}

// ---------- 侧边栏对话面板（WebviewView） ----------

class AgentPanelProvider {
  constructor() {
    this._view = null;
  }

  resolveWebviewView(view) {
    this._view = view;
    view.webview.options = { enableScripts: true };
    view.webview.html = this._html();
    view.webview.onDidReceiveMessage(async (message) => {
      if (message.type === "chat") {
        try {
          const data = await bridgeRequest("chat", {
            message: message.text,
            session_id: "panel",
          });
          refreshModelStatus();
          this._post({ type: "reply", text: data.reply, model: data.model });
        } catch (err) {
          this._post({ type: "reply", text: `出错了：${err.message}`, model: currentModel, error: true });
        }
      } else if (message.type === "ready") {
        refreshModelStatus().then(async () => {
          this._post({ type: "model", model: currentModel });
          try {
            const models = await bridgeRequest("models");
            this._post({ type: "models", models: models.models, current: models.current });
            if (!models.models || !models.models.length) this._post({ type: "hint" });
          } catch (err) {
            this._post({ type: "hint", detail: err.message });
          }
        });
      } else if (message.type === "switch") {
        try {
          await bridgeRequest("switch", { name: message.name });
          refreshModelStatus();
          this._post({ type: "model", model: message.name });
        } catch (err) {
          this._post({ type: "reply", text: `切换失败：${err.message}`, error: true, model: currentModel });
        }
      } else if (message.type === "openSettings") {
        settingsPanelProvider.open();
      }
    });
  }

  _post(message) {
    chatPanelView = this._view;
    if (this._view) this._view.webview.postMessage(message);
  }

  _html() {
    return `<!DOCTYPE html>
<html lang="zh"><head><meta charset="utf-8"><style>
body { font-family: -apple-system, 'Segoe UI', sans-serif; margin: 0; padding: .6rem; color: var(--vscode-foreground); }
#bar { display: flex; gap: .4rem; margin-bottom: .5rem; align-items: center; }
select { flex: 1; color: var(--vscode-input-foreground); background: var(--vscode-input-background);
  border: 1px solid var(--vscode-input-border); padding: .3rem; }
a.settings { font-size: 12px; color: var(--vscode-textLink-foreground); cursor: pointer; white-space: nowrap; }
#log { overflow-y: auto; height: calc(100vh - 116px); }
.msg { margin: .35rem 0; padding: .45rem .6rem; border-radius: 6px; white-space: pre-wrap; word-break: break-word; font-size: 13px; }
.user { background: var(--vscode-input-background); border: 1px solid var(--vscode-input-border); }
.bot  { background: var(--vscode-editor-background); border: 1px solid var(--vscode-panel-border); }
.bot.error { border-color: var(--vscode-errorForeground); }
.meta { opacity: .6; font-size: 11px; margin-top: .25rem; }
#bar2 { display: flex; gap: .4rem; position: fixed; bottom: .6rem; left: .6rem; right: .6rem; }
textarea { flex: 1; resize: none; height: 3.2em; color: var(--vscode-input-foreground);
  background: var(--vscode-input-background); border: 1px solid var(--vscode-input-border); padding: .35rem; }
button { color: var(--vscode-button-foreground); background: var(--vscode-button-background); border: none; padding: 0 .8rem; cursor: pointer; }
</style></head><body>
<div id="bar">
  <select id="modelSelect"><option value="">加载中…</option></select>
  <a class="settings" id="openSettings">模型设置…</a>
</div>
<div id="log"></div>
<div id="bar2">
  <textarea id="input" placeholder="向卅码助手提问（Enter 发送）"></textarea>
  <button id="send">发送</button>
</div>
<script>
const vscode = acquireVsCodeApi();
const log = document.getElementById('log');
function add(text, cls, meta) {
  const div = document.createElement('div');
  div.className = 'msg ' + cls;
  div.textContent = text;
  if (meta) { const m = document.createElement('div'); m.className = 'meta'; m.textContent = meta; div.appendChild(m); }
  log.appendChild(div); log.scrollTop = log.scrollHeight;
}
document.getElementById('send').onclick = send;
document.getElementById('input').addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
});
document.getElementById('openSettings').onclick = () => vscode.postMessage({ type: 'openSettings' });
document.getElementById('modelSelect').addEventListener('change', (e) => {
  if (e.target.value) vscode.postMessage({ type: 'switch', name: e.target.value });
});
function send() {
  const input = document.getElementById('input');
  const text = input.value.trim();
  if (!text) return;
  add(text, 'user');
  input.value = '';
  vscode.postMessage({ type: 'chat', text });
}
window.addEventListener('message', (event) => {
  const m = event.data;
  if (m.type === 'reply') add(m.text, m.error ? 'bot error' : 'bot', '模型: ' + m.model);
  else if (m.type === 'model') {
    add('当前模型: ' + m.model, 'bot', null);
    const sel = document.getElementById('modelSelect');
    if (sel.value !== m.model) { /* 保持用户选择优先 */ }
  }
  else if (m.type === 'models') {
    const sel = document.getElementById('modelSelect');
    sel.innerHTML = '';
    for (const name of m.models) {
      const opt = document.createElement('option');
      opt.value = name; opt.textContent = name;
      if (name === m.current) opt.selected = true;
      sel.appendChild(opt);
    }
    if (!m.models.length) {
      sel.innerHTML = '<option value="">未配置模型</option>';
    }
  }
  else if (m.type === 'hint') {
    add('还没有可用的模型配置。点击右上角「模型设置…」，添加你的模型和 API Key 并保存即可开始使用。'
      + (m.detail ? '\\n（' + m.detail + '）' : ''), 'bot');
  }
});
vscode.postMessage({ type: 'ready' });
</script></body></html>`;
  }
}

// ---------- 模型设置面板（可视化增删改模型与 API Key） ----------

class SettingsPanelProvider {
  constructor() {
    this._panel = null;
  }

  async open() {
    if (this._panel) {
      this._panel.reveal();
      return;
    }
    let config;
    try {
      config = await bridgeRequest("get_models");
    } catch (err) {
      vscode.window.showErrorMessage(`卅码 Agent：${err.message}`);
      return;
    }
    this._panel = vscode.window.createWebviewPanel(
      "sahouAgentSettings", "卅码 Agent · 模型设置",
      vscode.ViewColumn.Active, { enableScripts: true }
    );
    this._panel.webview.html = this._html(config);
    this._panel.webview.onDidReceiveMessage(async (message) => {
      if (message.type === "save") {
        try {
          const data = await bridgeRequest("save_models", {
            models: message.models, default: message.default,
          });
          refreshModelStatus();
          this._push({ type: "saved", current: data.current });
          this._syncModelsToChat();
        } catch (err) {
          this._push({ type: "error", message: err.message });
        }
      } else if (message.type === "close") {
        this._panel.dispose();
      }
    });
    this._panel.onDidDispose(() => { this._panel = null; });
  }

  _syncModelsToChat() {
    // 保存成功后刷新对话面板的模型下拉
    bridgeRequest("models").then((models) => {
      chatPanelPost({ type: "models", models: models.models, current: models.current });
    }).catch(() => {});
  }

  _push(message) {
    if (this._panel) this._panel.webview.postMessage(message);
  }

  _html(config) {
    const esc = (s) => String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
    const banner = config.init_error
      ? `<p style="color: var(--vscode-errorForeground)">⚠ 当前 Agent 未启动：${esc(config.init_error)}<br>
         在下方添加模型与 API Key 并保存，保存后会自动重新启动 Agent。</p>`
      : "";
    return `<!DOCTYPE html>
<html lang="zh"><head><meta charset="utf-8"><style>
body { font-family: -apple-system, 'Segoe UI', sans-serif; margin: .8rem; color: var(--vscode-foreground); font-size: 13px; }
.card { border: 1px solid var(--vscode-panel-border); border-radius: 6px; padding: .6rem; margin-bottom: .6rem; }
.row { display: flex; gap: .5rem; margin: .3rem 0; }
label { min-width: 4.5em; text-align: right; opacity: .8; line-height: 1.9; }
input { flex: 1; color: var(--vscode-input-foreground); background: var(--vscode-input-background);
  border: 1px solid var(--vscode-input-border); padding: .3rem .4rem; }
input[type="password"] { letter-spacing: 1px; }
.card input[type="radio"] { flex: 0; }
.del { color: var(--vscode-errorForeground); background: transparent; border: 1px solid var(--vscode-errorForeground); cursor: pointer; }
.add { margin: .4rem 0 1rem; }
#save { padding: .4rem 1.4rem; }
#tip { margin: .5rem 0; min-height: 1.2em; }
.ok { color: var(--vscode-testing-iconPassed, #73c991); }
.err { color: var(--vscode-errorForeground); }
small { opacity: .6; }
</style></head><body>
<h3>模型设置</h3>
${banner}
<p><small>配置保存到 ${esc(config.config_path)}（不使用 .env）。provider 选 openai 可接
DeepSeek / GLM / Kimi / 通义 / Ollama 等任何 OpenAI 兼容服务；选 anthropic 可接 Claude。
默认模型用于新对话开始时；对话中 agent 也可以自主调用 switch_model 切换。</small></p>
<div id="cards"></div>
<button class="add" id="add">＋ 添加自定义模型</button>
<p>默认模型：<span id="defaults"></span></p>
<button id="save">保存配置</button> <span id="tip"></span>
<script>
const vscode = acquireVsCodeApi();
let models = ${JSON.stringify(config.models).replace(/</g, "\\\\u003c")};
let defaultModel = ${JSON.stringify(config.default).replace(/</g, "\\\\u003c")};
const providers = ["openai", "anthropic"];

function render() {
  const cards = document.getElementById('cards');
  cards.innerHTML = '';
  models.forEach((m, i) => {
    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML =
      row('名称', 'text', 'name', m.name, i) +
      row('provider', 'select', 'provider', m.provider || 'openai', i) +
      row('base_url', 'text', 'base_url', m.base_url, i, '留空则用官方默认地址') +
      row('model', 'text', 'model', m.model, i) +
      row('api_key', 'password', 'api_key', m.api_key, i) +
      '<div class="row"><label>默认</label><input type="radio" name="def" ' +
      (m.name === defaultModel ? 'checked' : '') + ' data-i="' + i + '"></div>';
    const del = document.createElement('button');
    del.className = 'del'; del.textContent = '删除此模型';
    del.onclick = () => { models.splice(i, 1); render(); };
    card.appendChild(del);
    cards.appendChild(card);
  });
  const defs = document.getElementById('defaults');
  defs.textContent = models.map(m => m.name).join(' / ');
}
function row(label, type, field, value, i, hint) {
  if (type === 'select') {
    return '<div class="row"><label>' + label + '</label><select data-i="' + i + '" data-f="' + field + '">' +
      providers.map(p => '<option' + (p === value ? ' selected' : '') + '>' + p + '</option>').join('') + '</select></div>';
  }
  return '<div class="row"><label>' + label + '</label><input type="' + type + '" data-i="' + i + '" data-f="' + field + '" value="' + esc(value) + '" title="' + (hint || '') + '"></div>';
}
document.getElementById('add').onclick = () => {
  models.push({ name: 'model-' + (models.length + 1), provider: 'openai', base_url: '', api_key: '', model: '' });
  render();
};
document.getElementById('cards').addEventListener('input', (e) => {
  const t = e.target, i = t.dataset.i, f = t.dataset.f;
  if (i === undefined) return;
  if (f) models[+i][f] = t.value;
  if (t.type === 'radio') defaultModel = models[+i].name;
});
document.getElementById('save').onclick = () => {
  const tip = document.getElementById('tip');
  tip.className = ''; tip.textContent = '保存中…';
  vscode.postMessage({ type: 'save', models, default: defaultModel });
};
window.addEventListener('message', (event) => {
  const m = event.data;
  const tip = document.getElementById('tip');
  if (m.type === 'saved') { tip.className = 'ok'; tip.textContent = '已保存，当前模型: ' + m.current; }
  if (m.type === 'error') { tip.className = 'err'; tip.textContent = '保存失败: ' + m.message; }
});
render();
</script></body></html>`;
  }
}

let settingsPanelProvider = null;

// ---------- 注册入口（由 extension.js 的 activate 调用） ----------

function registerAgentFeatures(context) {
  bridge = new AgentBridgeProcess();
  context.subscriptions.push({ dispose: () => bridge && bridge.stop() });

  settingsPanelProvider = new SettingsPanelProvider();
  context.subscriptions.push(
    vscode.commands.registerCommand("sahou.agent.settings", () => settingsPanelProvider.open())
  );

  // 侧边栏视图容器 + 面板（package.json 里 contributes）
  const provider = new AgentPanelProvider();
  context.subscriptions.push(
    vscode.window.registerWebviewViewProvider("sahouAgent.panel", provider, {
      webviewOptions: { retainContextWhenHidden: true },
    })
  );

  context.subscriptions.push(
    vscode.commands.registerCommand("sahou.agent.open", async () => {
      await vscode.commands.executeCommand("sahouAgent.panel.focus");
    })
  );
  context.subscriptions.push(
    vscode.commands.registerCommand("sahou.agent.switchModel", switchModelCommand)
  );
  context.subscriptions.push(
    vscode.commands.registerCommand("sahou.agent.reload", async () => {
      if (bridge) bridge.stop();
      await refreshModelStatus();
      vscode.window.showInformationMessage("卅码 Agent 桥已重启。");
    })
  );

  // 状态栏：显示当前模型，点击打开面板；右键或命令面板可切模型
  statusBarItem = vscode.window.createStatusBarItem(vscode.StatusBarAlignment.Right, 90);
  statusBarItem.text = "$(hubot) 卅码 Agent";
  statusBarItem.tooltip = "卅码 Agent（点击打开对话面板）";
  statusBarItem.command = "sahou.agent.open";
  statusBarItem.show();
  context.subscriptions.push(statusBarItem);

  refreshModelStatus().catch(() => {});
}

module.exports = { registerAgentFeatures };
