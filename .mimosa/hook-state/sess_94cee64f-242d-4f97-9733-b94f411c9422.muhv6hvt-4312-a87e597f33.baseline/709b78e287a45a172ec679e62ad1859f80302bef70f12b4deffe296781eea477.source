"""卅码 Agent 桥：把 nanoagent agent 与编辑器连起来。

职责：
    - 从 JSON 配置文件构建 ModelPool 与 Agent（不使用 .env）
    - 给 agent 配一套面向卅语言开发的工具：
        read_file / write_file   读写工作区内文件（路径限制在工作区内）
        run_sahou                用 sahou 解释器运行 .saho 文件并返回输出
        list_models / switch_model   查看/切换模型（自主切换的核心：
                                 模型可以根据任务需要自己决定换模型）
    - handle(action, payload) 提供统一入口，供 stdio 服务与单测调用
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))

from model_pool import ModelPool, load_config

INSTRUCTIONS = (
    "你是卅码（Shaoma Code）内置的中文编程助手，熟悉卅（sahou）中文编程语言"
    "（.saho 文件，中文关键字如 打印/如果/当/函数）。"
    "你可以读写工作区文件、运行 .saho 文件来验证结果。"
    "回答使用简体中文，简洁准确。"
)


class AgentBridge:
    """一个桥实例 = 一个 agent 会话运行时。"""

    def __init__(
        self,
        config_path: str | Path,
        workspace: str | Path,
        sahou_exe: Optional[str] = None,
    ):
        self.config_path = Path(config_path)
        self.config = load_config(self.config_path)
        self.pool = ModelPool(self.config)
        self.workspace = Path(workspace).resolve() if workspace else Path.cwd().resolve()
        self.sahou_exe = sahou_exe or "sahou"
        self.agent = self._build_agent()

    # ------------------------------------------------------------------
    def _build_agent(self) -> Any:
        from nanoagent import Agent
        from nanoagent.memory import Memory
        from nanoagent.tools import make_tool

        if not hasattr(self, "memory") or self.memory is None:
            self.memory = Memory()  # 重建 agent（如保存配置后）时保留会话记忆
        tools = [
            make_tool(self.read_file),
            make_tool(self.write_file),
            make_tool(self.run_sahou),
            make_tool(self.list_models),
            make_tool(self.switch_model),
        ]
        return Agent(
            name="卅码助手",
            instructions=INSTRUCTIONS,
            llm=self.pool.get(),
            tools=tools,
            memory=self.memory,
        )

    # ------------------------------------------------------------------
    def _safe_path(self, path: str, must_exist: bool = False) -> Path:
        """工作区路径监狱：拒绝绝对路径出界与 .. 逃逸。"""
        from nanoagent.coding import SandboxViolation

        candidate = Path(path)
        resolved = candidate.resolve() if candidate.is_absolute() else (self.workspace / candidate).resolve()
        if resolved != self.workspace and self.workspace not in resolved.parents:
            raise SandboxViolation(f"路径越出工作区: {path}")
        if must_exist and not resolved.is_file():
            raise FileNotFoundError(f"文件不存在: {path}")
        return resolved

    def read_file(self, path: str) -> str:
        """读取工作区内的文件内容（带行号，超长截断）。

        Args:
            path: 工作区相对路径
        """
        resolved = self._safe_path(path, must_exist=True)
        lines = resolved.read_text(encoding="utf-8", errors="replace").splitlines()
        return "\n".join(f"{i + 1:>4}: {line}" for i, line in enumerate(lines))[:8000] or "（空文件）"

    def write_file(self, path: str, content: str) -> str:
        """写入工作区内的文件（新建或覆盖），自动创建父目录。

        Args:
            path: 工作区相对路径
            content: 完整文件内容
        """
        resolved = self._safe_path(path)
        resolved.parent.mkdir(parents=True, exist_ok=True)
        resolved.write_text(content, encoding="utf-8")
        return f"已写入 {path}（{len(content.splitlines())} 行）"

    def run_sahou(self, path: str, timeout: int = 30) -> str:
        """用 sahou 解释器运行工作区内的 .saho 文件，返回程序输出。

        Args:
            path: .saho 文件的工作区相对路径
            timeout: 超时秒数
        """
        try:
            resolved = self._safe_path(path, must_exist=True)
        except Exception as exc:  # noqa: BLE001
            return f"错误: {exc}"
        try:
            completed = subprocess.run(
                [self.sahou_exe, "run", str(resolved)],
                cwd=str(self.workspace), capture_output=True, text=True,
                timeout=timeout, encoding="utf-8", errors="replace",
            )
        except FileNotFoundError:
            return f"错误：找不到 sahou 解释器（{self.sahou_exe}），请在设置里配置 sahou.path 或使用内置解释器"
        except subprocess.TimeoutExpired:
            return f"错误：程序超时（>{timeout}s）"
        output = (completed.stdout or "") + (completed.stderr or "")
        return f"[exit {completed.returncode}] {output.strip() or '（无输出）'}"

    # ------------------------------------------------------------------
    def list_models(self) -> str:
        """列出配置里的全部模型与当前使用的模型。"""
        info = self.pool.info()
        return "可用模型: " + ", ".join(info["models"]) + f"（当前: {info['current']}）"

    def switch_model(self, name: str) -> str:
        """切换当前使用的模型。新对话与后续工具调用都会用新模型。

        Args:
            name: 模型名称，见 list_models 的输出
        """
        result = self.pool.switch(name)
        # agent 自身的 llm 也要换掉，后续轮次与对话才真正用新模型
        if self.agent is not None:
            self.agent.llm = self.pool.get()
        return result

    # ------------------------------------------------------------------
    def chat(self, message: str, session_id: str = "panel") -> Dict[str, Any]:
        """与 agent 对话一轮，返回回答与运行信息。"""
        result = self.agent.run(message, session_id=session_id)
        return {
            "reply": result.content,
            "model": self.pool.current,
            "tool_calls": result.tool_calls,
        }

    def handle(self, action: str, payload: Optional[Dict[str, Any]] = None) -> Dict[str, Any]:
        """统一动作入口（编辑器面板 / stdio 服务 / 测试共用）。"""
        payload = payload or {}
        if action == "chat":
            data = self.chat(payload.get("message", ""), payload.get("session_id", "panel"))
        elif action == "models":
            data = self.pool.info()
        elif action == "switch":
            data = {"result": self.switch_model(str(payload.get("name", "")))}
        elif action == "status":
            llm = getattr(self.agent, "llm", None)
            data = {
                "model": self.pool.current,
                "workspace": str(self.workspace),
                "config": str(self.config_path),
                "usage": getattr(llm, "total_usage", {}),
            }
        elif action == "get_models":
            data = self.get_models()
        elif action == "save_models":
            data = self.save_models(payload.get("models") or [], payload.get("default"))
        else:
            return {"ok": False, "error": f"未知动作: {action}"}
        return {"ok": True, "data": data}

    # ------------------------------------------------------------------
    # 模型配置的可视化管理（编辑器设置面板读写，无需手编 JSON）
    # ------------------------------------------------------------------
    def get_models(self) -> Dict[str, Any]:
        """返回完整模型配置（供设置表单展示与编辑）。"""
        return {
            "default": self.config.get("default") or (self.pool.names()[0] if self.pool.names() else ""),
            "models": list(self.config.get("models") or []),
            "config_path": str(self.config_path),
        }

    def save_models(self, models: List[Dict[str, Any]], default: Optional[str] = None) -> Dict[str, Any]:
        """保存模型配置：写回 JSON 文件并热重建模型池与 agent（保留会话记忆）。

        供"模型设置"面板使用，支持自定义模型（任意 openai/anthropic 兼容服务）。
        """
        cleaned: List[Dict[str, Any]] = []
        seen: set = set()
        for entry in models:
            name = str(entry.get("name") or "").strip()
            provider = (str(entry.get("provider") or "openai").strip() or "openai").lower()
            model = str(entry.get("model") or "").strip()
            api_key = str(entry.get("api_key") or "").strip()
            base_url = str(entry.get("base_url") or "").strip()
            if not name or not model or not api_key:
                raise ValueError("每个模型都需要 唯一名称、model 与 api_key")
            if name in seen:
                raise ValueError(f"模型名称重复: {name}")
            if provider not in ("openai", "anthropic"):
                raise ValueError(f"不支持的 provider: {provider}（可选 openai / anthropic）")
            seen.add(name)
            cleaned.append({
                "name": name, "provider": provider, "base_url": base_url,
                "api_key": api_key, "model": model,
            })
        if not cleaned:
            raise ValueError("至少需要配置一个模型")
        if not default:
            default = self.pool.current if self.pool.current in seen else cleaned[0]["name"]
        if default not in seen:
            raise ValueError(f"默认模型 '{default}' 不在模型列表里")

        self.config = {"default": default, "models": cleaned}
        self.config_path.parent.mkdir(parents=True, exist_ok=True)
        self.config_path.write_text(
            json.dumps(self.config, ensure_ascii=False, indent=2), encoding="utf-8"
        )
        # 热重建：模型池 + agent（memory 保留，对话不丢）
        self.pool = ModelPool(self.config)
        self.agent = self._build_agent()
        return {"current": self.pool.current, "models": self.pool.names()}
