"""JSON 配置与 profile 管理（不使用 .env）。

profile 目录结构（默认 .harness/profiles/default/）：
    config.json        模型列表 / 默认模型 / 权限
    plugins/           已安装的外部插件
    sessions/          会话历史（每会话一个 JSON）
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any, Dict, List, Optional

DEFAULT_CONFIG: Dict[str, Any] = {
    "default_model": "",
    "models": [],          # [{name, provider, base_url, api_key, model}]
    "permissions": {"shell": "ask"},   # ask / allow / deny
}

CONFIG_EXAMPLE = {
    "default_model": "deepseek",
    "models": [
        {"name": "deepseek", "provider": "openai",
         "base_url": "https://api.deepseek.com/v1",
         "api_key": "sk-...", "model": "deepseek-chat"},
    ],
    "permissions": {"shell": "ask"},
}


class Profile:
    """一个 harness profile：配置 + 插件 + 会话的隔离目录。"""

    def __init__(self, root: str | Path):
        self.root = Path(root)
        self.config_path = self.root / "config.json"
        self.plugins_dir = self.root / "plugins"
        self.sessions_dir = self.root / "sessions"
        self._ensure()

    def _ensure(self) -> None:
        self.plugins_dir.mkdir(parents=True, exist_ok=True)
        self.sessions_dir.mkdir(parents=True, exist_ok=True)
        if not self.config_path.is_file():
            self.config_path.write_text(
                json.dumps(CONFIG_EXAMPLE, ensure_ascii=False, indent=2), encoding="utf-8"
            )

    # -- 配置 ------------------------------------------------------------
    def load_config(self) -> Dict[str, Any]:
        try:
            data = json.loads(self.config_path.read_text(encoding="utf-8"))
        except (ValueError, OSError):
            data = {}
        config = dict(DEFAULT_CONFIG)
        config.update(data if isinstance(data, dict) else {})
        return config

    def save_config(self, config: Dict[str, Any]) -> None:
        self.config_path.write_text(
            json.dumps(config, ensure_ascii=False, indent=2), encoding="utf-8"
        )

    def update_config(self, **changes: Any) -> Dict[str, Any]:
        config = self.load_config()
        config.update(changes)
        self.save_config(config)
        return config

    # -- 插件安装 --------------------------------------------------------
    def install_plugin(self, source: str | Path) -> Path:
        """把本地插件目录复制进 profile（git URL 请先 clone 到本地再装）。"""
        import shutil

        source = Path(source)
        if not source.is_dir():
            raise FileNotFoundError(f"插件目录不存在: {source}")
        dest = self.plugins_dir / source.name
        counter = 2
        while dest.exists():
            dest = self.plugins_dir / f"{source.name}-{counter}"
            counter += 1
        shutil.copytree(source, dest)
        return dest

    def remove_plugin(self, name: str) -> None:
        import shutil

        target = self.plugins_dir / name
        if target.is_dir():
            shutil.rmtree(target)

    # -- 会话 ------------------------------------------------------------
    def save_session(self, session_id: str, history: List[dict]) -> Optional[Path]:
        path = self.sessions_dir / f"{session_id}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(history, ensure_ascii=False, indent=2), encoding="utf-8")
        return path

    def load_session(self, session_id: str) -> List[dict]:
        path = self.sessions_dir / f"{session_id}.json"
        if not path.is_file():
            return []
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            return data if isinstance(data, list) else []
        except ValueError:
            return []

    def session_ids(self) -> List[str]:
        return sorted(p.stem for p in self.sessions_dir.glob("*.json"))
