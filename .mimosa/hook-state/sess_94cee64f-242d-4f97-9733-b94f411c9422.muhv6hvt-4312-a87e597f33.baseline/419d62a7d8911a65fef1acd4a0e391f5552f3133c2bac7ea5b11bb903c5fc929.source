{
  "name": "sahou-language",
  "displayName": "sahou（卅）语言支持",
  "description": "sahou 编程语言：语法高亮、文件识别、一键运行、实时语法诊断与补全（内置解释器，开箱即用）",
  "version": "1.0.1",
  "publisher": "sahou",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "./icons/saho.png",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:sahou",
    "onView:sahouAgent.panel"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sahou",
        "aliases": [
          "sahou",
          "卅"
        ],
        "extensions": [
          ".saho"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/saho.png",
          "dark": "./icons/saho.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sahou",
        "scopeName": "source.sahou",
        "path": "./syntaxes/sahou.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sahou",
        "path": "./snippets/sahou.json"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sahou"
      }
    ],
    "commands": [
      {
        "command": "sahou.run",
        "title": "运行当前 sahou 文件",
        "category": "sahou",
        "icon": "$(play)"
      },
      {
        "command": "sahou.restartLsp",
        "title": "重启 sahou 语言服务",
        "category": "sahou"
      },
      {
        "command": "sahou.agent.open",
        "title": "打开 Agent 对话面板",
        "category": "卅码 Agent",
        "icon": "$(hubot)"
      },
      {
        "command": "sahou.agent.switchModel",
        "title": "切换 Agent 模型",
        "category": "卅码 Agent"
      },
      {
        "command": "sahou.agent.settings",
        "title": "打开模型设置（可视化配置 API Key / 自定义模型）",
        "category": "卅码 Agent"
      },
      {
        "command": "sahou.agent.reload",
        "title": "重启 Agent 桥进程",
        "category": "卅码 Agent"
      }
    ],
    "keybindings": [
      {
        "command": "sahou.run",
        "key": "alt+s",
        "when": "editorLangId == sahou"
      }
    ],
    "configuration": {
      "title": "sahou",
      "properties": {
        "sahou.path": {
          "type": "string",
          "default": "",
          "description": "sahou 可执行文件的路径。留空则自动使用本产品内置的解释器（推荐）；也可指向其他 sahou.exe。"
        },
        "sahou.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "启用实时语法诊断与补全（由解释器的 lsp 子命令提供）"
        },
        "sahou.agent.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Agent 桥使用的 Python 解释器（需已安装 nanoagent 框架：pip install nanoagent）"
        },
        "sahou.agent.configPath": {
          "type": "string",
          "default": "",
          "description": "agent.json 配置文件路径（多模型与 API Key 都写在这里，不使用 .env）。留空则用工作区 .sahou/agent.json"
        },
        "sahou.agent.configName": {
          "type": "string",
          "default": "agent.json",
          "description": "工作区配置目录 .sahou/ 下的配置文件名"
        },
        "sahou.agent.bridgePath": {
          "type": "string",
          "default": "",
          "description": "agent_server.py 桥脚本路径。留空则自动使用产品内置的桥（推荐）"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sahouAgent",
          "title": "卅码 Agent",
          "icon": "./icons/saho.png"
        }
      ]
    },
    "views": {
      "sahouAgent": [
        {
          "type": "webview",
          "id": "sahouAgent.panel",
          "name": "对话"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "sahou.run",
          "group": "navigation",
          "when": "editorLangId == sahou"
        }
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {}
}
